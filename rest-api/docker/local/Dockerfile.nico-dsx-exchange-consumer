# Dev-only Dockerfile. Build context: repo root.
ARG RUST_VERSION=1.97.1
FROM rust:${RUST_VERSION}-slim-bookworm AS builder
RUN apt-get update && apt-get install -y \
    pkg-config libssl-dev libpq-dev ca-certificates protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY .cargo/ .cargo/
COPY crates/ crates/
COPY pxe/ pxe/
RUN cargo build --package carbide-dsx-exchange-consumer --release \
    && strip target/release/carbide-dsx-exchange-consumer

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y libssl3 libpq5 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /repo/target/release/carbide-dsx-exchange-consumer /opt/nico/nico-dsx-exchange-consumer
ENTRYPOINT ["/opt/nico/nico-dsx-exchange-consumer"]
