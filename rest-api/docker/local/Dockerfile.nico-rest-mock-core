# Local development Dockerfile for mock-core (nico mock gRPC server)

# Build stage
FROM --platform=$BUILDPLATFORM golang:1.26.4 AS builder

# Docker automatically provides these args during multi-platform builds
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev

# Set environment variables for cross-compilation
ENV CGO_ENABLED=0
ENV GOOS=$TARGETOS
ENV GOARCH=$TARGETARCH

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Copy go module files first for better caching
COPY rest-api/go.mod rest-api/go.sum ./
# Copy SDK go module files, required for maintaining separate go.mod for SDK
COPY rest-api/sdk/standard/go.mod ./sdk/standard/
# provider-api: required by rest-api/go.mod replace directive
COPY provider-api/ ../provider-api/
COPY providers/provisioner-metal3/ ../providers/provisioner-metal3/
COPY providers/switch-config/ ../providers/switch-config/
ENV GOWORK=off
ENV GONOSUMDB=github.com/NVIDIA/infra-controller/*
# Download dependencies
RUN go mod download

# Copy source files
COPY rest-api/site-agent/ ./site-agent/
COPY rest-api/common/ ./common/
COPY rest-api/site-manager/ ./site-manager/
COPY rest-api/proto/ ./proto/
COPY rest-api/site-workflow/ ./site-workflow/
COPY rest-api/cert-manager/ ./cert-manager/

# Build mock-core (nico mock gRPC server)
WORKDIR /workspace/site-agent
RUN VERSION=${VERSION} && \
    BUILD_TIME=$(date +"%Y-%m-%d %H:%M:%S") && \
    go build \
        -ldflags "-extldflags '-static' -w -s \
                  -X 'github.com/NVIDIA/infra-controller/rest-api/site-agent/pkg/metadata.Version=${VERSION}' \
                  -X 'github.com/NVIDIA/infra-controller/rest-api/site-agent/pkg/metadata.BuildTime=${BUILD_TIME}'" \
        -o /app/mock-core \
        ./cmd/mock-core

# Final stage
FROM nvcr.io/nvidia/distroless/go:v4.0.8 AS final

WORKDIR /app

# Copy binaries from builder
COPY --from=builder --chown=nvs:nvs /app/mock-core /app/mock-core

# Switch to non-root user
USER nvs

# Expose gRPC port
EXPOSE 11079

# Run the application with default timeout of 0 (infinite)
ENTRYPOINT ["/app/mock-core"]
CMD ["-tout", "0"]
