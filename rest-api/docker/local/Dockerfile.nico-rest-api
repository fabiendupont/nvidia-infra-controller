# Local development Dockerfile for nico-rest-api

# Build stage
FROM --platform=$BUILDPLATFORM golang:1.26.4 AS builder

# Docker automatically provides these args during multi-platform builds
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev

# Set environment variables for cross-compilation
ENV CGO_ENABLED=0
ENV GOOS=$TARGETOS
ENV GOARCH=$TARGETARCH

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Copy go module files first for better caching
COPY rest-api/go.mod rest-api/go.sum ./
# Copy SDK go module files, required for maintaining separate go.mod for SDK
COPY rest-api/sdk/standard/go.mod ./sdk/standard/
# Copy provider-api module: rest-api/go.mod has replace => ../provider-api.
# GOWORK=off disables workspace mode so the replace directive is used directly.
COPY provider-api/ ../provider-api/
ENV GOWORK=off
ENV GONOSUMDB=github.com/NVIDIA/infra-controller/*
# Download dependencies
RUN go mod download

# Copy necessary source files
COPY rest-api/api/ ./api/
COPY rest-api/provider/ ./provider/
COPY rest-api/common/ ./common/
COPY rest-api/auth/ ./auth/
COPY rest-api/db/ ./db/
COPY rest-api/proto/ ./proto/
COPY rest-api/workflow/ ./workflow/
COPY rest-api/site-workflow/ ./site-workflow/
COPY rest-api/ipam/ ./ipam/
COPY rest-api/site-manager/ ./site-manager/
COPY rest-api/cert-manager/ ./cert-manager/
COPY rest-api/openapi/ ./openapi/
COPY rest-api/cli/ ./cli/

# Create Temporal certs directory
RUN mkdir -p /var/secrets/temporal/certs

# Build the application
WORKDIR /workspace/api
RUN VERSION=${VERSION} && \
    echo "VERSION: ${VERSION}" && \
    BUILD_TIME=$(date +"%Y-%m-%d %H:%M:%S") && \
    go build \
        -ldflags "-extldflags '-static' -w -s \
                  -X 'github.com/NVIDIA/infra-controller/rest-api/api/pkg/metadata.Version=${VERSION}' \
                  -X 'github.com/NVIDIA/infra-controller/rest-api/api/pkg/metadata.BuildTime=${BUILD_TIME}'" \
        -o /app/api \
        ./cmd/api

# Build the CLI client (shipped alongside the API as a debugging convenience)
WORKDIR /workspace/cli
RUN go build \
        -ldflags "-extldflags '-static' -w -s" \
        -o /app/nicocli \
        ./cmd/cli

# Final stage
FROM nvcr.io/nvidia/distroless/go:v4.0.8 AS final

WORKDIR /app

# Copy binary from builder
COPY --from=builder --chown=nvs:nvs /app/api /app/api
COPY --from=builder --chown=nvs:nvs /app/nicocli /app/nicocli

# Copy Temporal certs directory
COPY --from=builder --chown=nvs:nvs /var/secrets/temporal/certs /var/secrets/temporal/certs

# Switch to non-root user
USER nvs

# Expose application port
EXPOSE 8388

# Run the application
ENTRYPOINT ["/app/api"]
