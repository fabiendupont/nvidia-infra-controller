go 1.26.4

use (
	./rest-api
	./provider-api
	./provider-sdk
	./providers/catalog
	./providers/dpfhcp
	./providers/fabric-ufm
	./providers/provisioner-metal3
	./providers/spectrum-fabric
	./providers/firmware
	./providers/fulfillment
	./providers/health
	./providers/nvswitch
	./providers/showback
)

replace (
	// Local private dependency for UFM fabric provider (not published to a module proxy).
	github.com/fabiendupont/nvidia-ufm-api => /home/fdupont/Code/github.com/fabiendupont/nvidia-ufm-api

	// Compatibility shim: old monolithic genproto conflicts with the post-split
	// googleapis/api and googleapis/rpc modules. Pin to a post-split version.
	google.golang.org/genproto v0.0.0-20200423170343-7949de9c1215 => google.golang.org/genproto v0.0.0-20240903143218-8af14fe29dc1
)
